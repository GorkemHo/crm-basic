# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET_KEY=
# Optional: creates an admin user on first start
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=
ADMIN_LANGUAGE=tr
# Set to true and start with `--profile messaging` to use RabbitMQ
RABBITMQ_ENABLED=false
RABBITMQ_PASSWORD=crm
# Optional OpenTelemetry collector, e.g. http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
